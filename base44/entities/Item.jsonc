{
  "name": "Item",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "description": "C\u00f3digo \u00fanico do item"
    },
    "name": {
      "type": "string",
      "description": "Nome do item"
    },
    "type": {
      "type": "string",
      "enum": [
        "EPI",
        "Equipamento",
        "Material de Consumo",
        "Medicamento"
      ],
      "description": "Tipo do item"
    },
    "unit": {
      "type": "string",
      "description": "Unidade de medida (un, cx, pct, etc)"
    },
    "quantity": {
      "type": "number",
      "default": 0,
      "description": "Quantidade atual em estoque"
    },
    "minimum_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque m\u00ednimo para alerta"
    },
    "safety_stock": {
      "type": "number",
      "default": 0,
      "description": "Estoque de seguran\u00e7a (calculado automaticamente: m\u00ednimo * 1.2)"
    },
    "location": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o no almoxarifado"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Data de validade (para medicamentos e EPIs)"
    },
    "ca_number": {
      "type": "string",
      "description": "N\u00famero do CA (para EPIs)"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do item"
    },
    "supplier": {
      "type": "string",
      "description": "Fornecedor principal"
    },
    "last_unit_price": {
      "type": "number",
      "description": "\u00daltimo pre\u00e7o unit\u00e1rio registrado"
    }
  },
  "required": [
    "code",
    "name",
    "type",
    "unit"
  ]
}